# Normalize commit type to lowercase.
# Uses awk rather than `sed -E 's/^[A-Za-z]+/\L&/'`: \L is a GNU sed extension,
# and BSD/macOS sed substitutes a literal "L" instead, prefixing every line and
# corrupting the message. Scoped to line 1, which is where the type lives.
awk 'NR == 1 && match($0, /^[A-Za-z]+/) { $0 = tolower(substr($0, 1, RLENGTH)) substr($0, RLENGTH + 1) } { print }' "$1" > "$1.tmp" && mv "$1.tmp" "$1"

npx --no-install commitlint --edit "$1"
